#!/bin/bash
#SBATCH --job-name=projections
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=slurm-%j.out
# Supply --account, --partition, and optional --qos to sbatch for your cluster.

set -e
# Activate a configured environment; initialize conda and any required modules before submission.
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate YOUR_ENV_NAME

# run surface calculations
python -u generate_cfd_surfaces.py
